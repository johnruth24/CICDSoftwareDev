#!/bin/sh

# Move to the root of the working tree
cd "$(git rev-parse --show-toplevel)"

echo "Running Flake8..."
flake8
if [ $? -ne 0 ]; then
  echo "❌ Linting failed. Commit aborted."
  exit 1
fi

echo "Running PyTest..."
pytest
if [ $? -ne 0 ]; then
  echo "❌ Tests failed. Commit aborted."
  exit 1
fi

echo "✅ All checks passed. Commit allowed."
exit 0
